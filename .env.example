# Copy to .env and fill in. .env is ignored by Git; never commit a key.
# Variables already set in the environment take precedence over this file.

# Vultr Serverless Inference key. Leave empty to disable the AI step.
VULTR_SERVERLESS_INFERENCE_API_KEY=
VULTR_MODEL=deepseek-v4.1-flash-1017

# Required to start api.dev_main.
FOLLOWUP_ENABLE_LOCAL_AGENT=1

# Optional: give each browser a private fictional case (public deployments).
# FOLLOWUP_GUEST_SESSIONS=1
# FOLLOWUP_SECURE_COOKIES=1
